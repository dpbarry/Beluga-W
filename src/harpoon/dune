; harpoon_core: the proof-engine core, separated from the terminal driver so it
; can link in the js_of_ocaml web build (BelJar's Proof Lab drives these tactics).
; No terminal deps (linenoise/optparser/Io/Repl), no file I/O. (wrapped false) is
; required so the driver's bare Tactic./Theorem. references resolve across the lib
; boundary. See memory: reference-harpoon-core-linkable.
(library
 (name harpoon_core)
 (package beluga)
 (wrapped false)
 (modules
  tactic
  translate
  automation
  theorem
  cidProgRewrite
  revisit
  web_recover)
 (libraries
  support
  beluga
  beluga_syntax
  beluga_parser)
 (instrumentation
  (backend bisect_ppx --bisect-silent yes)))

(library
 (name harpoon)
 (package beluga)
 (modules
  :standard
  \
  main
  tactic
  translate
  automation
  theorem
  cidProgRewrite
  revisit
  web_recover)
 (libraries
  sedlex
  linenoise
  support
  optparser
  harpoon_core
  beluga
  beluga_syntax
  beluga_parser
  dune-build-info)
 (instrumentation
  (backend bisect_ppx --bisect-silent yes)))

(executable
 (name main)
 (public_name harpoon)
 (modules main)
 (package beluga)
 (libraries
  sedlex
  linenoise
  support
  optparser
  harpoon
  harpoon_core
  beluga
  beluga_syntax
  beluga_parser
  dune-build-info))

(env
 (dev
  (flags
   (:standard -w +A-z-e-p-42-44-48-50-58-70 -warn-error +A-p-37-48-50-60))))
